
<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1400E5FF" />
            <stroke
                android:width="3dp"
                android:color="#3300E5FF" />
            <corners android:radius="28dp" />
        </shape>
    </item>

    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#24FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#8000E5FF" />
            <corners android:radius="25dp" />
        </shape>
    </item>
</layer-list>
